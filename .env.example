# Copy to .env and fill in by hand (docker/LOCAL.md). Never commit .env, never paste it in chat.
# Lines left empty are fine: only section 1 is required to run NodeTrail.

# ---------------------------------------------------------------------------------------------
# 1. Required now: two random strings you make up (20+ characters each). They never leave your
#    machine. PowerShell:  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
# ---------------------------------------------------------------------------------------------
# Shared by the web app and the API; the API refuses to start without it.
API_KEY=
# Shared by the API and the code runner; the runner refuses outside connections without it.
RUNNER_TOKEN=

# ---------------------------------------------------------------------------------------------
# 2. Needed later (week 5): model keys for generating and verifying content.
#    The generator and the verifier are different model families (apps/api/app/llm/routing.yaml).
# ---------------------------------------------------------------------------------------------
# platform.deepseek.com -> API keys (pay as you go). Generates items and hints.
DEEPSEEK_API_KEY=
DEEPSEEK_FREE_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# aistudio.google.com -> Get API key (free tier has rate limits and may use data to improve
# Google's products: fine for your own study, not for other learners' data). Verifies blind.
GEMINI_API_KEY=
GEMINI_VERIFY_MODEL=
# Learners who may see draft (unreviewed) grammar items, labelled "Bản nháp": your own learner id(s),
# comma-separated (the web app's About page shows it; until then: POST /learners, or ask the agent).
# Everyone else sees reviewed items only (specs/level-test).
DRAFT_ITEM_LEARNERS=
# Writing (specs/writing): essays per learner per day; the daily model budget (used from step 2.4).
WRITING_DAILY_ESSAYS=3
LLM_DAILY_COST_CAP_USD=1.0
LLM_DAILY_CALLS_PER_LEARNER=30
# Empty = the worker does not generate content (topic jobs fail with a named reason).
# --pipeline = generate and verify with the keys above.
WORKER_ARGS=

# ---------------------------------------------------------------------------------------------
# 3. Settings with working defaults: leave as they are unless you know why.
# ---------------------------------------------------------------------------------------------
# docker compose sets DATABASE_URL, TEI_URL, RUNNER_URL and CORS_ORIGINS for its own network and
# ignores these values. They are for running the API or the CLIs directly on your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/nodetrail
EMBEDDING_BACKEND=tei
TEI_URL=http://localhost:8080
TEI_API_KEY=
# Memory cap for the TEI container (docker compose). 8g by default; 3g on an 8 GB laptop.
TEI_MEMORY_LIMIT=
RUNNER_URL=
CORS_ORIGINS=http://localhost:3000
# Only for running the API without a key during development; never with real learners.
ALLOW_UNAUTHENTICATED_LOCAL_DEV=false
# Placement: bayes (posterior over knowledge states, default) or walk (original graph walk).
PLACEMENT_STRATEGY=bayes
# auto selects an eligible indexed book by goal; a subject slug pins a library for diagnostics.
RESEARCH_SUBJECT=auto
RETRIEVAL_K=12
# Uploads were a competition-demo feature and need a privacy review before real learners.
DEMO_UPLOADS_ENABLED=false

# ---------------------------------------------------------------------------------------------
# 4. Not needed: kept because the code still has adapters for them. Leave empty.
# ---------------------------------------------------------------------------------------------
# Web search for Deep Research and CRAG (after Tết): brave or tavily.
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
# Upload storage used in the contest (Supabase Storage).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_BUCKET=uploads
# Legacy model providers from the contest (cloud credits). DeepSeek and Gemini replace them.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_FREE_MODEL=
VERTEX_GRAPH_MODEL=
VERTEX_VERIFY_MODEL=
AWS_REGION=ap-southeast-1
AWS_PROFILE=
BEDROCK_FREE_MODEL=
BEDROCK_PRO_MODEL=
BEDROCK_VERIFY_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=
OPENROUTER_GRAPH_MODEL=
OPENROUTER_PRO_MODEL=
OPENROUTER_VERIFY_MODEL=

# The web app outside docker compose (compose sets these itself): NODETRAIL_DATA_MODE=api,
# NODETRAIL_API_URL=http://localhost:8000, NODETRAIL_API_KEY=<API_KEY>, NODETRAIL_API_KEY_HEADER=x-api-key.
