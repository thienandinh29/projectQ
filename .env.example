# Copy to .env and fill in by hand. Never commit .env, never paste keys in chat.
# On the cloud VM, prefer the VM's attached service account / instance role over key files.

# LLM providers (order and model roles per tier/task live in apps/api/app/llm/routing.yaml)
# Google Cloud — Vertex AI (primary, organizer credits)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=
# AWS — Bedrock (backup, and the cross-family verifier / Pro tutor)
AWS_REGION=ap-southeast-1
AWS_PROFILE=
# OpenRouter (last fallback)
OPENROUTER_API_KEY=
# Agreed deployment: DeepSeek generation, Gemini verification.
DEEPSEEK_API_KEY=
# Suggested initial ID: deepseek-flash; choose after live/model-quality checks.
DEEPSEEK_FREE_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Gemini Developer API key (Google AI Studio); separate from Vertex ADC/billing.
GEMINI_API_KEY=
GEMINI_VERIFY_MODEL=
# Exact model IDs authorized in your account; families must match P3 routing.yaml.
VERTEX_FREE_MODEL=
VERTEX_GRAPH_MODEL=
VERTEX_VERIFY_MODEL=
BEDROCK_FREE_MODEL=
BEDROCK_PRO_MODEL=
BEDROCK_VERIFY_MODEL=
OPENROUTER_FREE_MODEL=
OPENROUTER_GRAPH_MODEL=
OPENROUTER_PRO_MODEL=
OPENROUTER_VERIFY_MODEL=

# Web search for Deep Research (search API with domain filtering)
# brave or tavily (Tavily uses basic search, one credit per request)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# Embeddings (bge-m3): local (embed extra) or tei (CPU container on the local host).
# These settings are available to adapters; ingest/library CLIs use explicit flags below.
EMBEDDING_BACKEND=tei
TEI_URL=http://localhost:8080
TEI_API_KEY=
RERANK_URL=
HF_TOKEN=

# Supabase (also holds the topic_jobs queue during the contest; Storage keeps uploaded files)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPLOAD_BUCKET=uploads
DATABASE_URL=

# Observability (contest: structlog + Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# API security (shared between web and API). Required at API startup and by docker compose
# (any long random string); disable only for explicit local development.
API_KEY=
ALLOW_UNAUTHENTICATED_LOCAL_DEV=false
# Competition demo only; uploads require explicit demo-v1 consent on each request.
DEMO_UPLOADS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# Cloud VM only: named Cloudflare Tunnel on the team domain
CLOUDFLARE_TUNNEL_TOKEN=

# Web (apps/web)
NEXT_PUBLIC_API_URL=https://api.<your-domain>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# After the contest
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# auto selects an eligible indexed book by goal; a subject slug pins a library for diagnostics.
RESEARCH_SUBJECT=auto
RETRIEVAL_K=12

# Placement: bayes (posterior over knowledge states, default) or walk (original graph walk).
PLACEMENT_STRATEGY=bayes

# Code practice: the runner service (runner/README.md). Routes /code/* are mounted only when set.
# docker compose sets RUNNER_URL itself; RUNNER_TOKEN is required there (any long random string).
RUNNER_URL=
RUNNER_TOKEN=

# docker compose (docker/LOCAL.md): extra worker arguments. Empty = no content generation (jobs fail
# with a named reason); --pipeline = generate and verify with the model keys above.
WORKER_ARGS=
