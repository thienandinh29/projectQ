            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "answer_vi",
          "citations"
        ],
        "title": "AskResponse"
      },
      "AttemptInput": {
        "properties": {
          "learner_id": {
            "type": "string",
