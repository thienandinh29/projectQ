            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
