          },
          "concept_slug": {
            "type": "string",
            "title": "Concept Slug"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "prior": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "posterior": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Posterior"
          },
          "rule": {
            "type": "string",
            "title": "Rule"
          },
          "rule_vi": {
            "type": "string",
            "title": "Rule Vi"
          },
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "type": "array",
            "title": "Alternatives"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "concept_slug",
          "at",
          "rule",
          "rule_vi"
        ],
        "title": "DecisionTrace"
      },
      "Evidence": {
        "properties": {
          "item_id": {
            "anyOf": [
