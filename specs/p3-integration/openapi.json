            "minLength": 1,
            "title": "Learner Id"
          },
          "item_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Item Id"
          },
          "answer": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Answer"
          },
          "hints_used": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Hints Used",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "learner_id",
          "item_id",
          "answer"
        ],
        "title": "AttemptInput"
      },
      "AttemptResponse": {
        "properties": {
          "p_known": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Known"
          },
          "mastered": {
            "type": "boolean",
            "title": "Mastered"
          },
          "misconception_vi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Misconception Vi"
          },
          "remediation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Remediation"
              },
              {
                "type": "null"
              }
            ]
          },
          "traces": {
            "items": {
              "$ref": "#/components/schemas/DecisionTrace"
            },
            "type": "array",
            "title": "Traces"
          },
          "correct": {
            "type": "boolean",
            "title": "Correct"
          }
        },
        "type": "object",
        "required": [
          "p_known",
          "mastered",
          "traces",
          "correct"
        ],
        "title": "AttemptResponse"
      },
      "Citation": {
        "properties": {
          "title": {
            "type": "string",
