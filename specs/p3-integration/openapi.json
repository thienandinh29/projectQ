  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "concept_slug": {
            "type": "string",
            "title": "Concept Slug"
          },
          "p_known": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Known"
          },
          "why_not_vi": {
            "type": "string",
            "title": "Why Not Vi"
          }
        },
        "type": "object",
        "required": [
          "concept_slug",
          "p_known",
          "why_not_vi"
        ],
        "title": "Alternative"
      },
      "AskInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "subject": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "pro"
            ],
